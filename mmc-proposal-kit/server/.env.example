# =====================================================================
#  بوابة العروض الفنية — نموذج متغيرات البيئة (المرحلة الثانية)
#  انسخه إلى .env وعدّل القيم:  cp .env.example .env
#  لا ترفع .env إلى أي مستودع — يحتوي أسراراً.
# =====================================================================

# ============ بيانات الدفع (تظهر في صفحات الأسعار والفواتير) ============
PAYMENT_BANK_NAME=Union Bank
PAYMENT_ACCOUNT_HOLDER=سمر محمد بدوان عوض الزرو
PAYMENT_IBAN=JO07UBSI1220000330111332981002
PAYMENT_SWIFT=UBSIJOAXXXX
PAYMENT_CLIQ_ALIAS=samarza
# بريد التواصل بخصوص الدفع (اختياري)
PAYMENT_CONTACT_EMAIL=

# ============ الخادم ============
PORT=4000
HOST=0.0.0.0
# development | production
NODE_ENV=development

# ============ قاعدة البيانات ============
# ملف SQLite واحد. المجلد يُنشأ تلقائياً إن لم يوجد.
DB_PATH=./data/portal.db

# ============ الواجهة (الملفات الثابتة) ============
# جذر صفحات البوابة والحزمة. اتركه فارغاً ليستخدم
# ../webpages/technical-proposal-kit_v5 بجوار مجلد الخادم.
# في الإنتاج: WEB_ROOT=/var/www/tpkit
WEB_ROOT=

# ============ الأمان (إلزامي في الإنتاج) ============
# ولّد سراً قوياً:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# الخادم يرفض الإقلاع في الإنتاج إن كان هذا افتراضياً.
JWT_SECRET=ضع-سراً-قوياً-هنا-ب٤٨-حرفاً-على-الأقل
JWT_TTL=7d
COOKIE_NAME=tpkit_session
# true إلزامي عند العمل على HTTPS
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# ============ حدود الرفع ============
MAX_FILE_BYTES=26214400        # 25 م.ب للملف الواحد
MAX_FILES_PER_REQUEST=10

# ============ CORS (اتركه فارغاً إن كانت الواجهة من نفس الأصل) ============
CORS_ORIGIN=

# =====================================================================
#  التخزين — المرحلة الثانية
# =====================================================================
# local = قرص الخادم | s3 = أي خدمة متوافقة مع S3
# النظام يعمل محلياً بلا أي مفاتيح سحابية، وينتقل للسحابة بهذا المتغير فقط.
STORAGE_DRIVER=local

# مجلد القرص (يُستخدم فقط عند STORAGE_DRIVER=local)
UPLOAD_DIR=./uploads

# صلاحية الروابط الموقّعة بالثواني — قصيرة عمداً (افتراضي 5 دقائق)
SIGNED_URL_TTL=300

# ---------- إعدادات S3 (تُستخدم فقط عند STORAGE_DRIVER=s3) ----------
# AWS S3:        S3_ENDPOINT=  (اتركه فارغاً)   S3_REGION=eu-west-1
# Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   S3_REGION=auto
# MinIO محلي:    S3_ENDPOINT=http://127.0.0.1:9000                          S3_REGION=us-east-1
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true لـ R2 و MinIO وكل ما لا يدعم النطاق الفرعي (virtual-hosted style)
S3_FORCE_PATH_STYLE=true

# =====================================================================
#  النسخ الاحتياطي
# =====================================================================
# مجلد النسخ المحلية قبل الرفع
BACKUP_DIR=./backups
# بادئة المسار داخل السحابة
BACKUP_PREFIX=backups/db
# سياسة الاستبقاء: آخر 7 يومية + 4 أسبوعية + 12 شهرية
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# ارفع النسخ إلى السحابة (يتطلب STORAGE_DRIVER=s3)
BACKUP_UPLOAD=true

# =====================================================================
#  الجدولة داخل الخادم
# =====================================================================
# false = معطّلة بالكامل. true = النسخ الاحتياطي وفحص انتهاء الاشتراكات مجدولان.
SCHEDULER_ENABLED=false
# تعبير cron (5 حقول: دقيقة ساعة يوم شهر يوم-الأسبوع)
# افتراضي: 02:30 كل يوم
BACKUP_CRON=30 2 * * *
# افتراضي: 03:00 كل يوم
SUBSCRIPTION_EXPIRY_CRON=0 3 * * *
BACKUP_TZ=Asia/Riyadh
